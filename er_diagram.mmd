    PROJECTS ||--o| GIT_REPOSITORIES : "tracks"
    
    WORKSPACES ||--o{ FOLDERS : "structures"
    WORKSPACES ||--o{ FILES : "contains"
    WORKSPACES ||--o{ TERMINAL_SESSIONS : "runs"
    WORKSPACES ||--o{ AI_CHATS : "integrates"
    
